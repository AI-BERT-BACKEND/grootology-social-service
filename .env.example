# Database
DB_NAME=social_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_URL=jdbc:postgresql://postgres:5432/social_db

# Spring
SPRING_PROFILES_ACTIVE=local

# JWT
# IMPORTANTE: debe ser EXACTAMENTE el mismo valor en gateway, auth-service,
# notification-service y social-service para que los tokens se validen entre servicios.
JWT_SECRET=your_jwt_secret_min_32_chars

# Mail
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# CORS - comma-separated allowed origins
CORS_ALLOWED_ORIGINS=https://frontend-umber-seven-28.vercel.app,http://localhost:3000,http://localhost:5173

# Inter-service URLs (Feign clients)
PROFILE_SERVICE_URL=http://localhost:8081
APP_BASE_URL=http://localhost:8085

# Kafka / Azure Event Hub
# LOCAL: dejar kafka:9092 (no hay broker en el docker-compose; los eventos solo se loguean).
# QA/PROD: el equipo de DevOps configura estos valores como variables de entorno
#          en el Azure Container App. NO commitear el connection string real.
#   KAFKA_BOOTSTRAP_SERVERS=aibert-eventhubs-qa.servicebus.windows.net:9093
#   KAFKA_CONNECTION_STRING=Endpoint=sb://aibert-eventhubs-qa.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONNECTION_STRING=
KAFKA_NOTIFICATION_TOPIC=social.events
