# Database
DB_NAME=social_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_URL=jdbc:postgresql://postgres:5432/social_db

# Spring
SPRING_PROFILES_ACTIVE=local

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars

# Mail
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# CORS - comma-separated allowed origins
CORS_ALLOWED_ORIGINS=https://frontend-umber-seven-28.vercel.app,http://localhost:3000,http://localhost:5173

# Inter-service URLs (Feign clients)
PROFILE_SERVICE_URL=http://localhost:8081
APP_BASE_URL=http://localhost:8085
